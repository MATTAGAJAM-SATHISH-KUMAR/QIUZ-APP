# Environment Configuration - DO NOT COMMIT
NODE_ENV=development
PORT=4004

# OpenAI API (for AI features)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File Upload
MAX_UPLOAD_SIZE=10485760

# Live Quiz
LIVE_QUIZ_MAX_PARTICIPANTS=500

